        "\n",
        "<body>\n",
        "\n",
        "<div class=\"form-container\">\n",
        "\n",
        "    <h2 style=\"text-align:center;\">\n",
        "        AI Skill Assessment\n",
        "    </h2>\n",
        "\n",
        "    <p class=\"subtitle\" style=\"text-align:center;\">\n",
        "        <b>Course:</b> {{ course }}\n",
        "    </p>\n",
        "\n",
        "    <!-- Progress -->\n",
        "\n",
        "    <div class=\"progress-container\">\n",
        "\n",
        "        <div class=\"progress-text\">\n",
        "\n",
        "            Question {{ current_question }} / {{ total_questions }}\n",
        "\n",
        "        </div>\n",
        "\n",
        "        <div class=\"progress-bar\">\n",
        "\n",
        "            <div class=\"progress-fill\"\n",
        "                 style=\"width: {{ progress }}%;\">\n",
        "\n",
        "            </div>\n",
        "\n",
        "        </div>\n",
        "\n",
        "    </div>\n",
        "\n",
        "\n",
        "    <!-- ============================= -->\n",
        "    <!-- QUESTION -->\n",
        "    <!-- ============================= -->\n",
        "\n",
        "    {% if not show_result %}\n",
        "\n",
        "    <form action=\"{{ url_for('submit_answer') }}\" method=\"POST\">\n",
        "\n",
        "        <div class=\"question-card\">\n",
        "\n",
        "            <h3>{{ question }}</h3>\n",
        "\n",
        "        </div>\n",
        "\n",
        "        {% for option in options %}\n",
        "\n",
        "        <div class=\"option-card\">\n",
        "\n",
        "            <label>\n",
        "\n",
        "                <input\n",
        "                    type=\"radio\"\n",
        "                    name=\"answer\"\n",
        "                    value=\"{{ option }}\"\n",
        "                    required>\n",
        "\n",
        "                {{ option }}\n",
        "\n",
        "            </label>\n",
        "\n",
        "        </div>\n",
        "\n",
        "        {% endfor %}\n",
        "\n",
        "        <br>\n",
        "\n",
        "        <button\n",
        "            class=\"btn-primary\"\n",
        "            type=\"submit\"\n",
        "            style=\"width:100%;\">\n",
        "\n",
        "            Submit Answer\n",
        "\n",
        "        </button>\n",
        "\n",
        "    </form>\n",
        "\n",
        "    {% endif %}\n",
        "\n",
        "\n",
        "    <!-- ============================= -->\n",
        "    <!-- RESULT -->\n",
        "    <!-- ============================= -->\n",
        "\n",
        "    {% if show_result %}\n",
        "\n",
        "    <div class=\"feedback-box\">\n",
        "\n",
        "        {% if \"Correct\" in feedback %}\n",
        "\n",
        "        <h2 style=\"color:green;\">\n",
        "\n",
        "            ✅ Correct\n",
        "\n",
        "        </h2>\n",
        "\n",
        "        {% else %}\n",
        "\n",
        "        <h2 style=\"color:red;\">\n",
        "\n",
        "            ❌ Wrong\n",
        "\n",
        "        </h2>\n",
        "\n",
        "        {% endif %}\n",
        "\n",
        "        <hr>\n",
        "\n",
        "        <p>\n",
        "\n",
        "            <strong>Your Answer:</strong>\n",
        "\n",
        "            {{ selected_answer }}\n",
        "\n",
        "        </p>\n",
        "\n",
        "        <p>\n",
        "\n",
        "            <strong>Correct Answer:</strong>\n",
        "\n",
        "            {{ correct_answer }}\n",
        "\n",
        "        </p>\n",
        "\n",
        "        <p>\n",
        "\n",
        "            <strong>Explanation:</strong>\n",
        "\n",
        "            {{ explanation }}\n",
        "\n",
        "        </p>\n",
        "\n",
        "        <a href=\"{{ url_for('next_question') }}\">\n",
        "\n",
        "            <button\n",
        "                class=\"btn-primary\"\n",
        "                style=\"width:100%;\">\n",
        "\n",
        "                Next Question →\n",
        "\n",
        "            </button>\n",
        "\n",
        "        </a>\n",
        "\n",
        "    </div>\n",
        "\n",
        "    {% endif %}\n",
        "\n",
        "</div>\n",
        "\n",
        "<script src=\"{{ url_for('static', filename='js/script.js') }}\"></script>\n",
        "\n",
        "</body>\n",
        "\n",
        "</html>"
