        "                (session[\"user_id\"], course, index, title, None)\n",
        "            )\n",
        "\n",
        "        conn.commit()\n",
        "\n",
        "        cursor.execute(\n",
        "            \"\"\"\n",
        "            SELECT * FROM learning_topics\n",
        "            WHERE user_id=? AND course=?\n",
        "            ORDER BY topic_order\n",
        "            \"\"\",\n",
        "            (session[\"user_id\"], course)\n",
        "        )\n",
        "\n",
        "        topics = cursor.fetchall()\n",
        "\n",
        "    # Which topic should be shown right now\n",
        "    requested_id = request.args.get(\"topic_id\", type=int)\n",
        "\n",
        "    current_topic = None\n",
        "\n",
        "    if requested_id:\n",
        "        for topic_row in topics:\n",
        "            if topic_row[\"id\"] == requested_id:\n",
        "                current_topic = topic_row\n",
        "                break\n",
        "\n",
        "    if current_topic is None:\n",
        "        current_topic = topics[0]\n",
        "\n",
        "    # Generate the lesson content lazily, only the first time this\n",
        "    # particular topic is opened, then reuse it from the database\n",
        "    if not current_topic[\"content\"]:\n",
        "\n",
        "        content_html = generate_topic_content(\n",
        "            course,\n",
        "            current_topic[\"topic_title\"],\n",
        "            level\n",
        "        )\n",
        "\n",
        "        cursor.execute(\n",
        "            \"UPDATE learning_topics SET content=? WHERE id=?\",\n",
        "            (content_html, current_topic[\"id\"])\n",
        "        )\n",
        "\n",
        "        conn.commit()\n",
        "\n",
        "        cursor.execute(\n",
        "            \"SELECT * FROM learning_topics WHERE id=?\",\n",
        "            (current_topic[\"id\"],)\n",
        "        )\n",
        "\n",
