        "            <i class=\"fa-solid fa-brain\"></i>\n",
        "            AI Tutor\n",
        "        </div>\n",
        "\n",
        "        <div class=\"learning-course-info\">\n",
        "            <span class=\"learning-course-name\">{{ course }}</span>\n",
        "            <span class=\"level-badge level-{{ level | lower }}\">{{ level }}</span>\n",
        "        </div>\n",
        "\n",
        "        <div class=\"nav-btn\">\n",
        "            <a href=\"{{ url_for('logout') }}\" class=\"login-btn\">Logout</a>\n",
        "        </div>\n",
        "    </nav>\n",
        "</header>\n",
        "\n",
        "<div class=\"learning-wrapper\">\n",
        "\n",
        "    <aside class=\"learning-sidebar\">\n",
        "        <h4>Course Topics</h4>\n",
        "\n",
        "        <ul class=\"topic-list\">\n",
        "            {% for topic in topics %}\n",
        "            <li>\n",
        "                <a href=\"{{ url_for('learning', topic_id=topic['id']) }}\"\n",
        "                   class=\"topic-link {% if topic['id'] == current_topic['id'] %}active{% endif %}\">\n",
        "                    <span class=\"topic-number\">{{ loop.index }}</span>\n",
        "                    <span class=\"topic-title-text\">{{ topic['topic_title'] }}</span>\n",
        "                </a>\n",
        "            </li>\n",
        "            {% endfor %}\n",
        "        </ul>\n",
        "    </aside>\n",
