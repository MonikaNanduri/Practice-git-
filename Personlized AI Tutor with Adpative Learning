        "\n",
        "</div>\n",
        "\n",
        "<ul>\n",
        "\n",
        "<li><a href=\"#\">Home</a></li>\n",
        "\n",
        "\n",
        "\n",
        "<li><a href=\"#features\">Features</a></li>\n",
        "\n",
        "<li><a href=\"#courses\">Courses</a></li>\n",
        "\n",
        "\n",
        "\n",
        "</ul>\n",
        "\n",
        "<div class=\"nav-btn\">\n",
        "\n",
