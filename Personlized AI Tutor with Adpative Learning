        "            break\n",
        "\n",
        "    next_topic_id = None\n",
        "\n",
        "    if current_index + 1 < len(topics):\n",
        "        next_topic_id = topics[current_index + 1][\"id\"]\n",
        "\n",
        "    return render_template(\n",
        "        \"learning.html\",\n",
        "        course=course,\n",
        "        level=level,\n",
        "        topics=topics,\n",
        "        current_topic=current_topic,\n",
        "        next_topic_id=next_topic_id\n",
        "    )\n",
