        "        )\n",
        "\n",
        "        data = response.choices[0].message.content\n",
        "        data = clean_json(data)\n",
        "\n",
        "        topics = json.loads(data)\n",
        "\n",
        "        if not isinstance(topics, list) or len(topics) < 3:\n",
        "            raise Exception(\"Invalid topic list received\")\n",
        "\n",
        "        return topics\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"Topic List Generation Error :\", e)\n",
        "        return []\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# GENERATE TOPIC CONTENT (level-aware lesson, W3Schools style)\n",
        "# ==========================================================\n",
        "\n",
        "def generate_topic_content(course, topic_title, level):\n",
        "\n",
        "    prompt = f\"\"\"\n",
        "You are an AI Tutor teaching the topic \"{topic_title}\", which is part of\n",
        "the course \"{course}\". The student's assessed learning level is \"{level}\".\n",
        "\n",
        "Follow these teaching rules strictly, based on the level:\n",
        "\n",
        "- If level is \"Beginner\" or \"No Idea\":\n",
        "  Explain the topic thoroughly, starting from the basics. Use simple,\n",
        "  friendly language. Include at least one real-world example or analogy.\n",
        "  If the course is a programming language or a programming-related topic,\n",
        "  include a clear, well-commented code example.\n",
        "\n",
        "- If level is \"Intermediate\":\n",
        "  Briefly recap the basic idea in 2-3 sentences only, then spend most of\n",
        "  the explanation on deeper concepts, common mistakes, and best\n",
        "  practices. Include a code example if the course is programming-related.\n",
        "\n",
        "- If level is \"Advanced\":\n",
        "  Do not explain basics beyond one short sentence. Focus entirely on\n",
        "  advanced usage, internals, performance considerations, and best\n",
        "  practices. Include an advanced code example if the course is\n",
        "  programming-related.\n",
        "\n",
        "Format the explanation the way W3Schools formats a tutorial page: a short\n",
        "introduction, then clear sections, then an example.\n",
        "\n",
        "Return ONLY valid JSON with EXACTLY these keys:\n",
        "\"title\": the topic title as a string,\n",
        "\"explanation_html\": the full lesson content as a single string, using\n",
        "ONLY these simple HTML tags to format it: <p>, <h3>, <ul>, <li>,\n",
        "<strong>, and <pre><code>...</code></pre> for any code blocks. Do not\n",
        "include <html>, <head>, <body>, <script>, or <style> tags anywhere. Do\n",
        "not use markdown formatting such as ** or backticks outside of the\n",
        "<pre><code> blocks.\n",
        "\"\"\"\n",
        "\n",
        "    try:\n",
        "        response = client.chat(\n",
        "            model=\"mistral-small-latest\",\n",
        "            messages=[\n",
        "                ChatMessage(role=\"user\", content=prompt)\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        data = response.choices[0].message.content\n",
        "        data = clean_json(data)\n",
        "\n",
        "        lesson = json.loads(data)\n",
        "\n",
        "        explanation_html = lesson.get(\"explanation_html\", \"\")\n",
        "\n",
        "        if not explanation_html:\n",
        "            raise Exception(\"Empty explanation received\")\n",
        "\n",
        "        # Safety net: strip any script tags the model might add,\n",
        "        # since explanation_html is rendered with |safe in the template.\n",
        "        explanation_html = re.sub(\n",
        "            r\"<script.*?>.*?</script>\", \"\", explanation_html,\n",
        "            flags=re.IGNORECASE | re.DOTALL\n",
        "        )\n",
        "\n",
        "        return explanation_html\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"Topic Content Generation Error :\", e)\n",
        "        return (\n",
        "            \"<p>Sorry, we couldn't generate this lesson right now. \"\n",
        "            \"Please refresh the page to try again.</p>\"\n",
        "        )\n",
        "\n",
