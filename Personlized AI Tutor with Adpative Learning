        "%%writefile database.py\n",
        "import sqlite3\n",
        "\n",
        "\n",
        "# ===========================\n",
        "# DATABASE CONNECTION\n",
        "# ===========================\n",
        "\n",
        "def get_connection():\n",
        "\n",
        "    conn = sqlite3.connect(\"tutor.db\")\n",
        "\n",
        "    conn.row_factory = sqlite3.Row\n",
        "\n",
        "    return conn\n",
        "\n",
        "\n",
        "# ===========================\n",
        "# CREATE TABLES\n",
        "# ===========================\n",
        "\n",
        "def create_tables():\n",
        "\n",
        "    conn = get_connection()\n",
        "\n",
        "    cursor = conn.cursor()\n",
        "\n",
        "    # ===========================\n",
        "    # USERS TABLE\n",
        "    # ===========================\n",
        "\n",
        "    cursor.execute(\"\"\"\n",
        "\n",
        "    CREATE TABLE IF NOT EXISTS users(\n",
        "\n",
        "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "\n",
        "        full_name TEXT NOT NULL,\n",
        "\n",
        "        email TEXT UNIQUE NOT NULL,\n",
        "\n",
        "        password TEXT NOT NULL\n",
        "\n",
        "    )\n",
        "\n",
        "    \"\"\")\n",
        "\n",
        "\n",
        "    # ===========================\n",
        "    # STUDENT PROFILE\n",
        "    # ===========================\n",
        "\n",
        "    cursor.execute(\"\"\"\n",
        "\n",
        "    CREATE TABLE IF NOT EXISTS student_profile(\n",
        "\n",
        "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "\n",
        "        user_id INTEGER UNIQUE,\n",
        "\n",
        "        course TEXT,\n",
        "\n",
        "        language TEXT,\n",
        "\n",
        "        experience TEXT,\n",
        "\n",
        "        study_time TEXT,\n",
        "\n",
        "        goal TEXT,\n",
        "\n",
        "        hear TEXT,\n",
        "\n",
        "        assessment_score INTEGER DEFAULT 0,\n",
        "\n",
        "        learning_level TEXT,\n",
        "\n",
        "        FOREIGN KEY(user_id)\n",
        "\n",
        "        REFERENCES users(id)\n",
        "\n",
        "    )\n",
        "\n",
        "    \"\"\")\n",
        "\n",
        "\n",
        "    # ===========================\n",
        "    # ASSESSMENT RESULTS\n",
        "    # ===========================\n",
        "\n",
        "    cursor.execute(\"\"\"\n",
        "\n",
        "    CREATE TABLE IF NOT EXISTS assessment_results(\n",
        "\n",
        "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "\n",
        "        user_id INTEGER,\n",
        "\n",
        "        course TEXT,\n",
        "\n",
        "        score INTEGER,\n",
        "\n",
        "        total_questions INTEGER,\n",
        "\n",
        "        percentage INTEGER,\n",
        "\n",
        "        level TEXT,\n",
        "\n",
        "        completed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n",
        "\n",
        "        FOREIGN KEY(user_id)\n",
        "\n",
        "        REFERENCES users(id)\n",
        "\n",
